// Version info and the application manifest (common controls v6, per-monitor DPI, long paths, asInvoker: the
// launcher never asks for administrator rights).
// No SDK headers (like plugin/src/mxl_core.rc): CI compiles this with llvm-rc on Linux, so the constants are written out.

1 24 "launcher.manifest"  // 24 = RT_MANIFEST

// The art of the official Median XL launcher (launcher.median-xl.com), by the Median XL team (NOTICE.md). Ids: the
// Res* enum in src/win/window.cpp. 10 = RT_RCDATA.
1 ICON "icon.ico"
101 10 "background.png"
102 10 "logo.gif"
103 10 "popup-window.png"
104 10 "exocet.ttf"
105 10 "RobotoCondensed.ttf"
106 10 "comment.svg"

1 VERSIONINFO  // 1 = VS_VERSION_INFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS 0x40004  // VOS_NT_WINDOWS32
 FILETYPE 0x1  // VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "mxl-d2r"
			VALUE "FileDescription", "D2R-XL launcher"
			VALUE "FileVersion", "0.1.0"
			VALUE "ProductName", "D2R-XL"
			VALUE "ProductVersion", "0.1.0"
			VALUE "LegalCopyright", "D2R-XL, a port of Median XL by the Median XL team. Diablo II by Blizzard Entertainment."
			VALUE "OriginalFilename", "D2R-XL-Launcher.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
