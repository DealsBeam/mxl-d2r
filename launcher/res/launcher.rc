// Version info and the application manifest (common controls v6, per-monitor DPI, long paths, asInvoker: the
// launcher never asks for administrator rights).
// No SDK headers (like plugin/src/mxl_core.rc): CI compiles this with llvm-rc on Linux, so the constants are written out.

1 24 "launcher.manifest"  // 24 = RT_MANIFEST

1 VERSIONINFO  // 1 = VS_VERSION_INFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS 0x40004  // VOS_NT_WINDOWS32
 FILETYPE 0x1  // VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "mxl-d2r"
			VALUE "FileDescription", "Median XL launcher"
			VALUE "FileVersion", "0.1.0"
			VALUE "ProductName", "Median XL for D2R"
			VALUE "ProductVersion", "0.1.0"
			VALUE "LegalCopyright", "Median XL by the Median XL team. Diablo II by Blizzard Entertainment."
			VALUE "OriginalFilename", "MedianXL-Launcher.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
